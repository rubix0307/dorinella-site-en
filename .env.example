# Public origin for canonical / Open Graph URLs. Must be set in production: without it the sitemap, canonical
# addresses and schema.org links follow the Host of each request (a warning is logged at startup).
SITE_URL=https://lolakrissss.com

# Signs tracked outbound links (/go/) and the session. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Signs the visitor id cookie (app/visitors.py). Comma-separated: the first signs, all are accepted, so a
# rotation puts the new key first. Changing it without keeping the old one gives every visitor a new id.
VISITOR_KEYS=

# PostgreSQL (docker compose builds DATABASE_URL for the web container from these)
POSTGRES_DB=lolakrissss
POSTGRES_USER=lolakrissss
POSTGRES_PASSWORD=
# POSTGRES_PORT=5433

# Only needed when running the app outside docker compose:
# DATABASE_URL=postgresql+asyncpg://lolakrissss:change-me@localhost:5433/lolakrissss

# Sign-in with Google (the only way in): an OAuth client from Google Cloud Console.
# Authorized redirect URI there: <SITE_URL>/admin/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may open the course: admin (staff only, the default) | paid (staff and buyers) | public (everybody)
# COURSE_ACCESS=admin

# Payments: Stripe Checkout. Empty keys -> nobody can pay. sk_test_... keeps everything in Stripe's test mode.
# Webhook endpoint in the Stripe dashboard: <SITE_URL>/stripe/webhook (events: checkout.session.completed / expired,
# checkout.session.async_payment_failed, charge.refunded, charge.dispute.created / closed)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# 1 -> the buy buttons are shown to everybody; 0 (default) -> only to PAYMENTS_TESTERS (comma-separated sign-in emails) and staff
# PAYMENTS_PUBLIC=0
# PAYMENTS_TESTERS=
# Days a buyer may ask for the money back (shown on the pages and in the Refund Policy)
# REFUND_DAYS=14


# Sentry (errors, tracing, logs). Empty -> off (development, tests).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Daily database backup (app/backup.py): a private bucket whose key may only write, and BACKUP_KEY - 32 bytes, base64
# (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"). KEEP A COPY OF BACKUP_KEY elsewhere.
# Empty BACKUP_S3_BUCKET = no backups. BACKUP_HOUR is the UTC hour of the run (default 3).
# BACKUP_S3_KEY_ID= / BACKUP_S3_APPLICATION_KEY= / BACKUP_S3_BUCKET= / BACKUP_S3_ENDPOINT= / BACKUP_S3_REGION= / BACKUP_KEY=
