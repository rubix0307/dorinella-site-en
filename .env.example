# Public origin for canonical / Open Graph URLs
SITE_URL=https://dorinellla.com
# SITE_URL must be set in production: without it the sitemap, canonical addresses and schema.org links follow the Host of each request (a warning is logged at startup).

# Signs tracked outbound links (/go/). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Signs the visitor id cookie (app/visitors.py). Comma-separated: the first signs, all are accepted, so a
# rotation puts the new key first. Changing it without keeping the old one gives every visitor a new id.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
VISITOR_KEYS=change-me

# Newsletter consents (app/consent.py): the key that pseudonymises addresses in the consent log (HMAC-SHA256). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set it BEFORE the first consent is recorded and KEEP A COPY OUTSIDE THE SERVER: a lost or changed key makes the stored hashes unmatchable.
# NEWSLETTER_HASH_KEY=<generate it; unset falls back to a public development key, so never leave a placeholder>
# 1 (default): the first-sign-in screen offers the survey and the optional boxes; 0 hides only those, the acceptance of the terms is always required.
# SIGNUP_CONSENT_SCREEN_ENABLED=1

# PostgreSQL (docker compose builds DATABASE_URL for the web container from these)
POSTGRES_DB=dorinella
POSTGRES_USER=dorinella
POSTGRES_PASSWORD=change-me
# POSTGRES_PORT=5432

# Only needed when running the app outside docker compose:
# DATABASE_URL=postgresql+asyncpg://dorinella:change-me@localhost:5432/dorinella

# Sentry (errors, tracing, logs). Empty → off (development, tests).
# SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Embeddings (app/embeddings.py): the model lives in its own service (app/embed_service.py, container "embedder"),
# loads on the first request and unloads after EMBED_IDLE_SECONDS without requests. The model files are downloaded
# into volumes/models on first use.
# EMBEDDINGS_URL: where the site finds the service. Production compose sets http://embedder:8001 itself.
#   Empty (development, tests) -> the site runs the model in a short-lived child process instead.
# EMBEDDINGS_TOKEN: shared secret for the X-Embed-Token header, both sides read it: python -c "import secrets; print(secrets.token_urlsafe(32))"
# EMBEDDINGS_URL=
# EMBEDDINGS_TOKEN=
# EMBED_IDLE_SECONDS=60
# EMBED_THREADS=2

# Recipe media: production uses the media subdomain (nginx → Backblaze, deploy/nginx/media.dorinellla.conf);
# leave it unset locally to serve ./media from the app.
# MEDIA_URL=https://media.dorinellla.com
# B2_KEY_ID= / B2_APPLICATION_KEY= / B2_BUCKET=dorinellla-site / B2_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Video calls of the admins (admin -> Зустрічі): LiveKit + Egress run in docker compose, nothing in the cloud.
# LIVEKIT_API_SECRET: python -c "import secrets; print(secrets.token_urlsafe(36))"
# LIVEKIT_NODE_IP: the address of this computer on the local network (ipconfig / ip a), NOT 127.0.0.1 -
#   the recorder in another container has to reach the media port on it.
# LIVEKIT_URL: where the browser reaches LiveKit's signalling.
# The recordings land in volumes/recordings/<call>/ (one file per person / screen) with meta.json.
LIVEKIT_API_KEY=dorinella
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
LIVEKIT_NODE_IP=192.168.1.7
LIVEKIT_URL=ws://localhost:7880


# Where the recordings of the calls go. Empty MEET_S3_BUCKET → volumes/recordings (local disk).
# A PRIVATE bucket with its own application key (read, write, list): the site hands out only short-lived links.
# MEET_S3_KEY_ID= / MEET_S3_APPLICATION_KEY= / MEET_S3_BUCKET=dorinellla-site-meet
# MEET_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com / MEET_S3_REGION=eu-central-003

# Daily database backup (app/backup.py): a private bucket whose key may only write, and BACKUP_KEY - 32 bytes, base64
# (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"). KEEP A COPY OF BACKUP_KEY elsewhere.
# The Telegram bot's database through a read-only role, e.g. postgresql+asyncpg://dori_ro:PASSWORD@dori-bot-db:5432/dori (empty = no numbers in the Telegram section)
# BOT_DATABASE_URL=
# On the server it is derived by deploy.sh from the .env of the bot (DORI_RO_PASSWORD and POSTGRES_DB, /root/bot2/.env): do not write it by hand there.
# Empty BACKUP_S3_BUCKET = no backups. BACKUP_HOUR is the UTC hour of the run (default 3).
# BACKUP_S3_KEY_ID= / BACKUP_S3_APPLICATION_KEY= / BACKUP_S3_BUCKET= / BACKUP_S3_ENDPOINT= / BACKUP_S3_REGION= / BACKUP_KEY=

# Master key of the call recordings: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# MEET_MASTER_KEY=
# MEET_RECORD: 'audio' records only voices (light on a small server); 'all' also camera and screen (default)
# MEET_RECORD=audio
# MEET_CHUNK_SECONDS=30
# The words of the recordings are written down by a local model (nothing leaves the server): 'small' is light (about 1 GB of
# memory), 'medium' or 'large-v3' read Ukrainian better and need 2-4 GB. The language is found out by itself unless set (uk, ru, en).
# MEET_WHISPER_MODEL=small
# MEET_WHISPER_LANGUAGE=
# MEET_WHISPER_THREADS=2

# Sign-in is a Google account only (no passwords). OAuth client from Google Cloud Console → Credentials
# (type "Web application"). Authorized JavaScript origin (the button and One Tap): https://dorinellla.com — authorized
# redirect URI: https://dorinellla.com/admin/login/google/callback (SITE_URL must be set: the redirect URI is built from it).
# Anyone with a verified Google address can sign in: an existing account (matched by e-mail) keeps its role, a new
# address gets a plain account without admin access («Користувачі», or python -m app.cli create-admin).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Posts to Telegram channels from the site: the token of the bot, the chats (comma separated ids) the failures of a post are sent to,
# a private bucket for the files of the posts (empty = volumes/telegram), the minutes a scheduled post may be late is fixed at 2 (TELEGRAM_LATE_SECONDS)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALERT_CHAT_IDS=
# TG_S3_BUCKET=
# TG_S3_KEY_ID=
# TG_S3_APPLICATION_KEY=
# TG_S3_ENDPOINT=
# TG_S3_REGION=
# The files of the posts go to a PUBLIC bucket (empty bucket = the folder volumes/telegram). The key needs write, read and delete in that bucket only.
# TG_MEDIA_S3_BUCKET=
# TG_MEDIA_S3_KEY_ID=
# TG_MEDIA_S3_APPLICATION_KEY=
# TG_MEDIA_S3_ENDPOINT=
# TG_MEDIA_S3_REGION=
# Where the bucket is read from: with https://, without a trailing slash (default <endpoint>/<bucket>).
# TG_MEDIA_PUBLIC_URL=
# TG_MEDIA_PREFIX=tg-posts
# Only for providers that need a per-object ACL (public-read); Backblaze B2 does not.
# TG_MEDIA_ACL=
# 1 when TELEGRAM_API_BASE is a local Bot API server: files up to 2000 MB.
# TELEGRAM_LOCAL_API=

# Card payments through Stripe Checkout (hosted page; card data never reaches the site). Without the keys nobody can pay.
# STRIPE_SECRET_KEY: sk_test_... = the test mode (no money moves, orders are marked as test ones); sk_live_... takes real money.
# STRIPE_WEBHOOK_SECRET: whsec_... of the webhook endpoint <SITE_URL>/stripe/webhook (events: checkout.session.completed,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired, charge.refunded, charge.dispute.created).
# Receipts are Stripe's own e-mails: switch them on in the Stripe dashboard (Settings -> Emails). Never commit the keys.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# 0 (default) = only admins and PAYMENTS_TESTERS can start a payment; 1 = everybody (a product also has to be on_sale in app/catalog.py).
# PAYMENTS_PUBLIC=0
# Comma-separated e-mail addresses that may pay while the sales are closed to everybody else (their test purchases open the product for them).
# PAYMENTS_TESTERS=
# Days after the payment when a full refund is promised (the Refund Policy and the buy box show this number; the 14 days also cover the EU/UK right to cancel).
# REFUND_DAYS=14

# Support chat: messages one person may send into one ticket per hour before somebody takes it / after; open tickets one person may have.
# SUPPORT_LIMIT_WAITING=5
# SUPPORT_LIMIT_TAKEN=30
# SUPPORT_MAX_OPEN=3
# New tickets one person may open per hour (closing a ticket does not give the hour back; the staff has no limit).
# SUPPORT_TICKETS_PER_HOUR=5

# The model that sorts new support tickets into marketing / tech / spam / blogger (JEV by TypeSafe, https://docs.typesafe.ai). Only the message text is sent, no name, e-mail or id.
# Without a key, or with JEV_ENABLED=0, every ticket goes to tech marked «не вдалося визначити». Never commit the key.
# JEV_API_KEY=
# JEV_ENABLED=1
# JEV_MODEL=jev-latest
# Seconds to wait for the answer (the ticket is already saved: the sorting runs in the background).
# JEV_TIMEOUT=8
# An answer with a lower confidence (0..1) is treated as «не вдалося визначити»; «spam» needs the higher one.
# JEV_MIN_CONFIDENCE=0.5
# JEV_SPAM_MIN_CONFIDENCE=0.75
