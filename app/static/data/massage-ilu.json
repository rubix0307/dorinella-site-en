{"key":"m1","tag":"METHOD №1 · ТЕХНІКА I LOVE YOU","title":"Масаж «I Love You»","total":35.0,"captions":[[2.0,"Крок 1","Почніть із лівого боку, прямо всередині лівої тазостегнової кістки, і ведіть руки вниз за стрілкою."],[6.4,"Крок 2 · «I»","Почніть прямо під лівою грудною кліткою й ведіть руки вниз до лівої кістки таза, а далі — за стрілкою з першого кроку."],[13.6,"Крок 3 · «L»","Почніть прямо під правою грудною кліткою, проведіть руки поперек живота ліворуч і вниз — разом із попередніми рухами."],[22.4,"Крок 4 · «U»","Почніть всередині правої кістки стегна, ведіть руки вгору, поперек живота й униз ліворуч — разом з усіма попередніми рухами."],[32.9,"","Рухи — за ходом кишківника, м’яко і без болю"]],"moves":[{"t0":2.5,"dur":1.6,"pts":[603.5,751.7,603.2,754.7,602.8,757.7,602.4,760.6,601.9,763.6,601.3,766.5,600.7,769.5,600.0,772.4,599.2,775.3,598.2,778.1,597.1,780.9,595.8,783.6,594.2,786.2,592.5,788.6,590.4,790.8,588.2,792.8,585.9,794.7,583.3,796.3,580.7,797.7,578.0,799.1,575.3,800.3,572.5,801.4,569.7,802.4,566.9,803.5,564.0,804.5,561.2,805.5,558.4,806.6,555.6,807.5,552.7,808.3,549.8,809.0,546.8,809.7,543.9,810.2,540.9,810.8,538.0,811.3,535.0,811.8,532.1,812.3,529.1,812.8,526.2,813.3,523.2,813.9,520.3,814.6,517.4,815.3,514.5,816.2,511.6,817.0,508.7,817.9,505.9,818.7,503.0,819.5,500.1,820.4,497.3,821.4,494.6,822.7,491.9,824.1,489.4,825.8,487.2,827.7,485.1,829.9,483.3,832.3,481.7,834.8,480.3,837.5,479.1,840.2,477.9,843.0,476.9,845.8,475.9,848.6,475.0,851.5,474.1,854.4,473.3,857.3,472.5,860.1,471.8,863.1,471.0,866.0,470.3,868.9,469.6,871.8,469.0,874.7,468.5,877.7,468.0,880.6,467.7,883.6,467.4,886.6,467.1,889.6,467.1,889.6],"ease":"cos","press":0.14,"trail":431.4,"glow":true,"pulse":0.0,"tip":true},{"t0":4.4,"dur":1.6,"pts":[603.5,751.7,603.2,754.7,602.8,757.7,602.4,760.6,601.9,763.6,601.3,766.5,600.7,769.5,600.0,772.4,599.2,775.3,598.2,778.1,597.1,780.9,595.8,783.6,594.2,786.2,592.5,788.6,590.4,790.8,588.2,792.8,585.9,794.7,583.3,796.3,580.7,797.7,578.0,799.1,575.3,8